include makefile.objs

SHELL:= sh
NEWDATE  := $(shell date +%d.%m.%Y)

# TODO: add sanity checks
ifdef arch
ARCH := $(arch)
else
ARCH := $(shell uname -m)
endif
include ../../makefile.aros-common

# NAME is assigned in makefile.objs
DESTDIR  := ../../bin.$(ARCH)-aros
TARGET   := $(DESTDIR)/$(NAME)
OBJDIR  := .objects/$(AROS_OBJECT_ARCH)
OPTIMIZE := -O2
OPTIONS  := -DUSE_64BIT -DCOMPDATE=$(NEWDATE) -DARCH=$(ARCH)
INCLUDES := -I../../Include -Iinit -Iinit/../ -I../../ $(AROS_INCLUDES)
LDFLAGS  := $(AROS_NOSTARTFILES) $(AROS_LDFLAGS) $(AROS_MAPFLAG)
WARNINGS := -Wall -Wno-pointer-sign -fno-strict-aliasing -Werror-implicit-function-declaration
CFLAGS   := $(OPTIONS) $(DEBUG) $(DEBUGSYM) $(OPTIMIZE) $(AROS_CFLAGS)
LIBS     := $(AROS_LIBS)

REMOVE = rm -f
MAKEDIR := mkdir -p

OBJS = $(COMMON_OBJS)
SRC_OBJS := $(OBJS)
OBJS := $(addprefix $(OBJDIR)/,$(SRC_OBJS))

all : $(TARGET)

$(TARGET): $(OBJS)
	$(MAKEDIR) $(DESTDIR)
	$(LINK) $^ $(LDFLAGS) $(LIBS) -o $@

$(OBJDIR)/%.o : %.c
	@echo ">>>>>Compiling $<"
	@$(MAKEDIR) $(dir $@)
	@$(CC) -c $< $(CFLAGS) $(INCLUDES) $(WARNINGS) -o $@

.PHONY depend: Makefile.dep
Makefile.dep : $(SRC_OBJS:.o=.c)
	@$(CC) -MM $(CFLAGS) $(INCLUDES) $(SRC_OBJS:.o=.c) >Makefile.dep

.PHONY clean:
clean:
	@rm -rf $(OBJDIR)
.PHONY cleanall:
cleanall : clean
	@$(REMOVE) $(TARGET) $(TARGET).map $(TARGET).s

