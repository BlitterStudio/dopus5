
SHELL:= sh
NEWDATE  := $(shell date +%d.%m.%Y)

# TODO: add sanity checks
ifdef arch
ARCH := $(arch)
else
ARCH := $(shell uname -m)
endif
include ../../../makefile.aros-common

NAME     := viewfont
DESTDIR  := ../../../bin.$(ARCH)-aros
TARGET   := $(DESTDIR)/$(NAME)
OBJDIR  := .objects/$(AROS_OBJECT_ARCH)
OPTIMIZE := -O2
OPTIONS  := -DCOMPDATE=$(NEWDATE) -DARCH=$(ARCH)
INCLUDES := -I../../../Include $(AROS_INCLUDES)
LDFLAGS  := $(DEBUGSYM) $(AROS_LDFLAGS)
WARNINGS := -Wall -Wno-pointer-sign -fno-strict-aliasing -Werror-implicit-function-declaration
CFLAGS   := $(OPTIONS) $(DEBUG) $(DEBUGSYM) $(OPTIMIZE) $(AROS_CFLAGS)
LIBS     := $(AROS_LIBS)

REMOVE = rm -f
MAKEDIR := mkdir -p

OBJS = font_data.o font.o font_strings.o
SRC_OBJS := $(OBJS)
OBJS := $(addprefix $(OBJDIR)/,$(SRC_OBJS))

all : $(TARGET)

$(OBJDIR)/font_strings.o : font.strings

$(TARGET): $(OBJS)
	$(MAKEDIR) $(DESTDIR)
	$(LINK) $(AROS_PROGRAM_STARTUP) $^ $(LDFLAGS) $(LIBS) -o $@

$(OBJDIR)/%.o : %.c
	@$(MAKEDIR) $(dir $@)
	$(CC) -c $< $(CFLAGS) $(INCLUDES) $(WARNINGS) -o $@

.PHONY depend: Makefile.dep
Makefile.dep : $(SRC_OBJS:.o=.c)
	@$(CC) -MM $(CFLAGS) $(INCLUDES) $(SRC_OBJS:.o=.c) >Makefile.dep

.PHONY clean:
clean:
	@rm -rf $(OBJDIR)
.PHONY cleanall:
cleanall : clean
	@$(REMOVE) $(TARGET) $(TARGET).map $(TARGET).s

