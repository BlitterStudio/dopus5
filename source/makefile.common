SELF_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))

SOURCE_TOP := $(SELF_DIR)

CC := m68k-amigaos-gcc

SHELL:= sh
NEWDATE  := $(shell date +%d.%m.%Y)

# Enter debug=no on "Make" command line to disable debug output.
ifeq ($(debug), no)
	OPTIMIZE := -Os -fomit-frame-pointer
	DEBUGSYM := -g -ggdb
	DEBUG := -DNDEBUG
	#deferred evalution of $(TARGET)
	STRIP = m68k-amigaos-strip --strip-all -o $(TARGET) $(TARGET)_unstripped
	LIBS += -ldebug
else
	OPTIMIZE := -Og -fno-omit-frame-pointer
	DEBUGSYM := -g -ggdb
	DEBUG := -DDEBUG
	STRIP = m68k-amigaos-strip --strip-all -o $(TARGET) $(TARGET)_unstripped
	LIBS += -ldebug
endif

# CPU target. Default OS3 build targets 68020-60 with 68030 tuning.
# Set cpu=68000 (e.g. via `make os3-68000`) for a plain 68000 binary.
# OS3_SUFFIX is appended to bin/object directories so 68000 and default
# builds can coexist without polluting each other's outputs.
ifeq ($(cpu), 68000)
	CPUFLAGS   := -m68000
	OS3_SUFFIX := -68000
else
	CPUFLAGS   := -m68020-60 -mtune=68030
	OS3_SUFFIX :=
endif

# GCC 16+ m68k backend workaround: "unable to find a register to spill in
# class 'DATA_REGS'" when compiling Modules/show/show.c with -Os (also -O2/-O3
# under -flto). Reported upstream against berniecodewiz/m68k-amigaos-gcc
# gcc-v16.2-20260827; -fno-cse-follow-jumps avoids the faulty transform.
# Drop this block once a fixed GCC is verified.
GCC_MAJOR := $(shell $(CC) -dumpversion 2>/dev/null | cut -d. -f1)
ifeq ($(shell test "$(GCC_MAJOR)" -ge 16 2>/dev/null && echo yes),yes)
	OPTIMIZE += -fno-cse-follow-jumps
endif

OPTIONS  := $(CPUFLAGS) -flto -fshort-enums -D__amigaos3__ -D__USE_SYSBASE -D__NO_NET_API -DUSE_64BIT -DCOMPDATE=$(NEWDATE)
INCLUDES := -I./../ -Iinit/../ -I$(SOURCE_TOP) -I$(SOURCE_TOP)/Include $(OS3_INCLUDE)
LDFLAGS  := $(OPTIONS) $(DEBUGSYM) -noixemul
#
# With Link Time Optimization, provide the optimization flags to the linker, too
ifneq ($(filter -flto%,$(OPTIONS)),)
	LDFLAGS += $(OPTIMIZE)
endif

WARNINGS := -Wall -Wno-pointer-sign -Wno-attributes -Wno-int-conversion -Wno-int-to-pointer-cast -Wno-pointer-to-int-cast

CFLAGS   := $(OPTIONS) $(DEBUG) $(DEBUGSYM) $(OPTIMIZE) -noixemul
LIBS  += -lamiga
