;
; The release archive holds this script, its icon, DOpus5.info, the
; DOpus5 drawer, IconSets/MagicWB and Catalogs.  The script copies the
; DOpus5 drawer to the chosen place, with the MagicWB images and icons
; over the standard ones if the user wants them, and the chosen
; translations to LOCALE:Catalogs.  On an upgrade it replaces the
; program files and keeps the user's configuration: configuration
; drawers only receive the files they lack.
;
; source/makefile replaces @BUILD@ with the release target (os3,
; os3-68000, os4, mos, i386-aros, x86_64-aros or aarch64-aros).

(set @app-name "Directory Opus 5")
(set #build "@BUILD@")
(set #src "DOpus5")

(if (<> 1 (exists (tackon #src "DirectoryOpus") (noreq)))
    (abort "The DOpus5 drawer was not found next to this script.\n\nUnpack the complete Directory Opus 5 archive and start the installer from the drawer it was unpacked to."))


; --------------------------------------------------------------------
; Processor check for the AmigaOS 3 builds
; --------------------------------------------------------------------

(set #cpu (database "cpu"))

(if (and (= #build "os3") (or (= #cpu "68000") (= #cpu "68010")))
    (abort "This archive is the AmigaOS 3 build for 68020 and newer processors, and this Amiga has a " #cpu ".\n\nUse the DOpus5_<version>_os3-68000.lha archive instead."))

(if (and (= #build "os3-68000") (and (<> #cpu "68000") (<> #cpu "68010")))
    (message "This archive is the AmigaOS 3 build for the plain 68000, and this Amiga has a " #cpu ".\n\nIt works, but the DOpus5_<version>_os3.lha archive is built for 68020 and newer processors and runs faster."))


; --------------------------------------------------------------------
; Destination
; --------------------------------------------------------------------
;
; An existing DOpus5: assign points at the installation to upgrade (Opus
; also assigns DOpus5: to its own drawer while it runs).

(set #dest "")
(set #olddir (getassign "DOpus5" "a"))

(if (<> #olddir "")
    (if (= 1 (exists (tackon #olddir "DirectoryOpus") (noreq)))
        (if (askbool
               (prompt "Directory Opus 5 is installed in\n\n" #olddir "\n\nUpgrade that installation?")
               (help "Upgrading replaces the program, its libraries, modules, commands, manuals, ARexx scripts, images and stored items. Your settings, environments, button banks, filetypes, FTP sites and other configuration files are kept; configuration drawers only receive files they do not have yet.\n\nAnswer No to install a separate copy somewhere else.")
               (default 1))
            (set #dest #olddir))))

(if (= #dest "")
    (
       (set #parent "SYS:")
       (if (= 2 (exists "Work:" (noreq)))
           (set #parent "Work:"))

       (set #parent
          (askdir
             (prompt "Where should Directory Opus 5 be installed?\n\nA drawer called DOpus5 is created in the place you choose.")
             (help "Choose the parent drawer, not the DOpus5 drawer itself: choosing Work: installs Directory Opus 5 into Work:DOpus5.\n\nIf you choose a drawer that already holds Directory Opus 5, that installation is upgraded.")
             (newpath)
             (default #parent)))

       ; Someone picked the DOpus5 drawer itself
       (if (= 1 (exists (tackon #parent "DirectoryOpus") (noreq)))
           (set #dest #parent)
           (set #dest (tackon #parent "DOpus5")))
    ))

(set #upgrade 0)
(if (or (= 1 (exists (tackon #dest "DirectoryOpus") (noreq)))
        (= 2 (exists (tackon #dest "Settings") (noreq))))
    (set #upgrade 1))

(set @default-dest #dest)

(if #upgrade
    (message "Upgrading Directory Opus 5 in\n\n" #dest "\n\nQuit Directory Opus before you continue, so that the new program and library are used the next time it starts.\n\nYour configuration files are kept."))


; --------------------------------------------------------------------
; Images and icons
; --------------------------------------------------------------------
;
; The DOpus5 drawer holds the standard toolbar images and icons, made for
; RTG and other screens with many colours.  IconSets/MagicWB holds 8
; colour MagicWB versions of the same files, laid out like the archive
; root, button banks whose buttons have no border because the MagicWB
; images draw their own, and environments with icon remapping off, which
; only new installations receive.  #iconset 0 = standard, 1 = MagicWB;
; the choice is kept in ENVARC:DOpus5Icons.  Releases before it had only
; the standard set.

(set #mwb "IconSets/MagicWB")
(set #oldicons (getenv "DOpus5Icons"))
(set #oldset 0)
(if (= #oldicons "magicwb")
    (set #oldset 1))
(set #iconset #oldset)

; Without an earlier choice, suggest MagicWB on AmigaOS 3 without RTG
(if (and (= #oldicons "")
         (and (= (substr #build 0 3) "os3")
              (and (= 0 (exists "LIBS:Picasso96API.library" (noreq)))
                   (= 0 (exists "LIBS:cybergraphics.library" (noreq))))))
    (set #iconset 1))

(if (= 2 (exists (tackon #mwb "DOpus5") (noreq)))
    (set #iconset
       (askchoice
          (prompt "Which toolbar images and icons should Directory Opus 5 use?")
          (help "Standard: images and icons made for RTG and other screens with many colours.\n\n"
                "MagicWB: 8 colour images and icons in the MagicWB style (MWB_DOpus 8 by Trevor Morris and Leo Davidson), for 8 and 16 colour screens with the MagicWB palette. "
                "They use colours 0 to 7 of the screen."
                "\n\nOn an upgrade the DirectoryOpus, Help and drawer icons are kept, because they hold your tool types and window positions. "
                "The MagicWB versions are in the IconSets/MagicWB drawer of this archive.")
          (choices "Standard (many colours, RTG)" "MagicWB (8 or 16 colours)")
          (default #iconset)))
    (set #iconset 0))

(set #setname "standard")
(set #setsrc #src)
(if (= #iconset 1)
    (
       (set #setname "MagicWB")
       (set #setsrc (tackon #mwb "DOpus5"))
    ))

; The lister toolbar and the FTP bank belong to the images they show.  An
; upgrade that changes the images offers to replace them; the user's
; banks are kept as .old files.
(set #banks 0)
(if (and #upgrade (<> #iconset #oldset))
    (set #banks
       (askbool
          (prompt "Replace the lister toolbar and the FTP button bank with the " #setname " ones?")
          (help "The lister toolbar (Buttons/Toolbar) and the FTP bank (Buttons/FTP_image) show the images you chose. "
                "The MagicWB images draw their own button border, so these banks have borderless buttons in the MagicWB set and bordered ones in the standard set.\n\n"
                "Your current Toolbar and FTP_image are kept as Toolbar.old and FTP_image.old; Toolbar.default is replaced.")
          (default 1))))


; --------------------------------------------------------------------
; Translations
; --------------------------------------------------------------------
;
; Catalogs/<language> holds the translated catalogs.  They go to
; LOCALE:Catalogs/<language>, not DOpus5:Catalogs: locale.library looks
; in PROGDIR:Catalogs and LOCALE:Catalogs, and dopus5.library opens its
; catalog in the program that opens it first, often DOpus5:C/LoadDB or
; LoadDOpusLib, whose PROGDIR: is DOpus5:C.  Preselected: the language
; the Installer runs in, and languages that already have Opus catalogs.
; Bit #cat-n of #catalogs selects language #cat-n of P_CATALOG_LANGUAGE,
; in the order of the askoptions choices.

(procedure P_CATALOG_LANGUAGE
   (set #cat-lang
      (select #cat-n "deutsch" "español" "français" "greek" "italiano"
                     "magyar" "nederlands" "norsk" "polski" "português"
                     "svenska")))
(set #cat-count 11)

(set #catalogs 0)
(if (= 2 (exists "Catalogs" (noreq)))
    (
       (set #cat-default 0)
       (set #cat-n 0)
       (while (< #cat-n #cat-count)
          (P_CATALOG_LANGUAGE)
          (if (or (= @language #cat-lang)
                  (= 1 (exists (tackon (tackon "LOCALE:Catalogs" #cat-lang) "dopus.catalog") (noreq))))
              (set #cat-default (bitor #cat-default (shiftleft 1 #cat-n))))
          (set #cat-n (+ #cat-n 1)))
       (set #catalogs
          (askoptions
             (prompt "Which translations of Directory Opus 5 should be installed?\n\nDirectory Opus uses the first language of the Locale preferences that it has a translation for.")
             (help "The catalogs of each language you choose are copied to LOCALE:Catalogs/<language>. "
                   "Untranslated texts are shown in English, and so is everything when no language is chosen.\n\n"
                   "Preselected are the language the Installer runs in and languages whose Directory Opus catalogs are already installed.")
             (choices "deutsch" "español" "français" "greek" "italiano"
                      "magyar" "nederlands" "norsk" "polski" "português"
                      "svenska")
             (default #cat-default)))
    ))

(complete 5)


; --------------------------------------------------------------------
; Copy files
; --------------------------------------------------------------------

; Copies the files from #src/#pdir that #dest/#pdir does not have yet.
; Used for configuration drawers on an upgrade.
(procedure P_ADD_MISSING
   (set #pd-src (tackon #src #pdir))
   (set #pd-dst (tackon #dest #pdir))
   (if (= 2 (exists #pd-src (noreq)))
       (
          (if (= 0 (exists #pd-dst (noreq)))
              (makedir #pd-dst
                 (prompt "Create " #pd-dst)
                 (help "This configuration drawer is new in this release.")))
          (foreach #pd-src "#?"
             (if (and (= 1 (exists (tackon #pd-src @each-name) (noreq)))
                      (= 0 (exists (tackon #pd-dst @each-name) (noreq))))
                 (copyfiles
                    (prompt "Add " @each-name " to " #pd-dst)
                    (help "This file is new in this release. Existing configuration files are not replaced.")
                    (source (tackon #pd-src @each-name))
                    (dest #pd-dst))))
       )))

; Replaces the contents of #src/#pdir in #dest/#pdir.
(procedure P_REPLACE
   (if (= 2 (exists (tackon #src #pdir) (noreq)))
       (copyfiles
          (prompt "Install " #pdir)
          (help "Replaces the files of this drawer with the ones from this release. Files you added yourself are kept.")
          (source (tackon #src #pdir))
          (dest (tackon #dest #pdir))
          (all)
          (infos))))

; Copies #pfile of the chosen set to #dest unless it is already there.
(procedure P_ADD_FILE
   (if (and (= 1 (exists (tackon #setsrc #pfile) (noreq)))
            (= 0 (exists (tackon #dest #pfile) (noreq))))
       (copyfiles
          (prompt "Add " #pfile)
          (help "")
          (source (tackon #setsrc #pfile))
          (dest #dest))))

; Replaces the files of #dest/#pdir with the MagicWB ones.
(procedure P_SET_REPLACE
   (if (= 2 (exists (tackon #setsrc #pdir) (noreq)))
       (copyfiles
          (prompt "Install the " #setname " files in " #pdir)
          (help "")
          (source (tackon #setsrc #pdir))
          (dest (tackon #dest #pdir))
          (all)
          (infos))))

; Installs the button bank #bank of the chosen set; with #bank-keep the
; user's bank is kept as <bank>.old first.
(procedure P_BANK
   (set #bk-src (tackon (tackon #setsrc "Buttons") #bank))
   (set #bk-dir (tackon #dest "Buttons"))
   (if (= 1 (exists #bk-src (noreq)))
       (
          (if (and #bank-keep (= 1 (exists (tackon #bk-dir #bank) (noreq))))
              (copyfiles
                 (prompt "Keep " #bank " as " #bank ".old")
                 (help "")
                 (source (tackon #bk-dir #bank))
                 (dest #bk-dir)
                 (newname (cat #bank ".old"))))
          (copyfiles
             (prompt "Install the " #setname " " #bank)
             (help "")
             (source #bk-src)
             (dest #bk-dir))
       )))

; Drawer icon (not for a volume root), only when the drawer has none.
; It goes in before the files: Installer 47 gives a drawer without an
; icon a default one when copyfiles (infos) copies into it, and that new
; icon could not always be replaced straight away ("object in use").
(set #drawer-src "DOpus5.info")
(if (= #iconset 1)
    (set #drawer-src (tackon #mwb "DOpus5.info")))
(set #drawer-icon (cat #dest ".info"))
(if (and (<> (fileonly #dest) "")
         (and (= 1 (exists #drawer-src (noreq)))
              (= 0 (exists #drawer-icon (noreq)))))
    (copyfiles
       (prompt "Install the drawer icon")
       (help "")
       (source #drawer-src)
       (dest (pathonly #dest))
       (newname (fileonly #drawer-icon))))

; The OS 3.2 Installer copies icons with (all) alone; (infos) asks for
; them explicitly for Installer versions that read the options strictly.
(if (not #upgrade)
    (copyfiles
       (prompt "Install Directory Opus 5 into " #dest)
       (help "Copies the complete DOpus5 drawer.")
       (source #src)
       (dest #dest)
       (all)
       (infos))
    (
       (copyfiles
          (prompt "Install the Directory Opus program")
          (help "")
          (source (tackon #src "DirectoryOpus"))
          (dest #dest))

       ; Program files, manuals and shipped extras
       (set #pdir "Libs")      (P_REPLACE)
       (set #pdir "Modules")   (P_REPLACE)
       (set #pdir "C")         (P_REPLACE)
       (complete 30)
       (set #pdir "Help")      (P_REPLACE)
       (set #pdir "ARexx")     (P_REPLACE)
       (set #pdir "Icons")     (P_REPLACE)
       (set #pdir "Images")    (P_REPLACE)
       (set #pdir "Storage")   (P_REPLACE)
       (set #pdir "WBStartup") (P_REPLACE)
       (complete 60)

       ; Configuration: only what is missing
       (set #pdir "Buttons")         (P_ADD_MISSING)
       (set #pdir "Environment")     (P_ADD_MISSING)
       (set #pdir "Settings")        (P_ADD_MISSING)
       (set #pdir "Filetypes")       (P_ADD_MISSING)
       (set #pdir "Commands")        (P_ADD_MISSING)
       (set #pdir "Desktop")         (P_ADD_MISSING)
       (set #pdir "Groups")          (P_ADD_MISSING)
       (set #pdir "Themes")          (P_ADD_MISSING)
       (set #pdir "Sounds")          (P_ADD_MISSING)
       (set #pdir "System")          (P_ADD_MISSING)
       (set #pdir "System/Scripts")  (P_ADD_MISSING)
       (set #pdir "System/_copyto")  (P_ADD_MISSING)

       ; Icons that may carry the user's tool types
       (set #pfile "DirectoryOpus.info") (P_ADD_FILE)
       (set #pfile "Help.info")          (P_ADD_FILE)
    ))

; MagicWB files over the standard ones: all of them for a new
; installation, the program drawers for an upgrade.
(if (= #iconset 1)
    (if (not #upgrade)
        (copyfiles
           (prompt "Install the MagicWB images and icons")
           (help "")
           (source #setsrc)
           (dest #dest)
           (all)
           (infos))
        (
           (set #pdir "Help")      (P_SET_REPLACE)
           (set #pdir "Icons")     (P_SET_REPLACE)
           (set #pdir "Images")    (P_SET_REPLACE)
           (set #pdir "WBStartup") (P_SET_REPLACE)
        )))

(if #banks
    (
       (set #bank-keep 1)
       (set #bank "Toolbar")         (P_BANK)
       (set #bank "FTP_image")       (P_BANK)
       (set #bank-keep 0)
       (set #bank "Toolbar.default") (P_BANK)
    ))

; Translations
(set #cat-n 0)
(while (< #cat-n #cat-count)
   (if (bitand #catalogs (shiftleft 1 #cat-n))
       (
          (P_CATALOG_LANGUAGE)
          (set #cat-src (tackon "Catalogs" #cat-lang))
          (set #cat-dst (tackon "LOCALE:Catalogs" #cat-lang))
          (if (= 2 (exists #cat-src (noreq)))
              (
                 (if (= 0 (exists "LOCALE:Catalogs" (noreq)))
                     (makedir "LOCALE:Catalogs"
                        (prompt "Create LOCALE:Catalogs")
                        (help "")))
                 (if (= 0 (exists #cat-dst (noreq)))
                     (makedir #cat-dst
                        (prompt "Create " #cat-dst)
                        (help "")))
                 (copyfiles
                    (prompt "Install the " #cat-lang " translation in " #cat-dst)
                    (help "")
                    (source #cat-src)
                    (dest #cat-dst)
                    (all))
              ))
       ))
   (set #cat-n (+ #cat-n 1)))

(complete 75)


; --------------------------------------------------------------------
; Stored filetypes from older releases
; --------------------------------------------------------------------
;
; Releases up to 5.102 named the files in Storage/Filetypes differently
; ("Picture,_GIF" is now "Graphics, Pic-GIF") and kept copies of filetypes
; that are now installed.  A file is only removed when its replacement is
; present.

(set #olds (tackon #dest "Storage/Filetypes"))
(set #oldft-pass 0)
(set #oldft-found 0)

(procedure P_OLD_FILETYPE
   (if (and (= 1 (exists (tackon #olds #old) (noreq)))
            (= 1 (exists #new (noreq))))
       (if (= #oldft-pass 0)
           (set #oldft-found (+ #oldft-found 1))
           (delete (tackon #olds #old)
              (prompt "Remove the old stored filetype " #old)
              (help "")
              (optional "force")))))

(procedure P_OLD_FILETYPES
   (set #old "ARC_archive"                #new (tackon #olds "Archive, ARC"))                (P_OLD_FILETYPE)
   (set #old "ARJ_archive"                #new (tackon #olds "Archive, ARJ"))                (P_OLD_FILETYPE)
   (set #old "ARexx_script"               #new (tackon #olds "System, ARexx Script"))        (P_OLD_FILETYPE)
   (set #old "AmigaDOS_program"           #new (tackon #olds "System, Program"))             (P_OLD_FILETYPE)
   (set #old "AmigaDOS_runtime_library"   #new (tackon #olds "System, Library"))             (P_OLD_FILETYPE)
   (set #old "Animation,_IFF_ANIM"        #new (tackon #olds "Graphics, Anim-IFF"))          (P_OLD_FILETYPE)
   (set #old "CanDo_deck,_IFF_DECK"       #new (tackon #olds "CanDo, Deck"))                 (P_OLD_FILETYPE)
   (set #old "CanDo_variable,_IFF_CDVR"   #new (tackon #olds "CanDo, Variable"))             (P_OLD_FILETYPE)
   (set #old "Digitized_sound,_IFF_8SVX"  #new (tackon #olds "Audio, IFF 8SVX"))             (P_OLD_FILETYPE)
   (set #old "DiskMasher_archive"         #new (tackon #olds "Archive, Disk DMS DiskImage")) (P_OLD_FILETYPE)
   (set #old "FinalCopy_document"         #new (tackon #olds "Document, FinalCopy"))         (P_OLD_FILETYPE)
