   (set #old "ASCII"      #new (tackon #dest "Filetypes/ASCII"))      (P_OLD_FILETYPE)
   (set #old "AmigaGuide" #new (tackon #dest "Filetypes/AmigaGuide")) (P_OLD_FILETYPE)
   (set #old "Font"       #new (tackon #dest "Filetypes/Font"))       (P_OLD_FILETYPE)
