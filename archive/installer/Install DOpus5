   (set #old "Imagine_object,_IFF_TDDD"   #new (tackon #olds "Imagine object, IFF TDDD"))    (P_OLD_FILETYPE)
   (set #old "Imagine_picture,_IFF_RGBN"  #new (tackon #olds "Imagine picture, IFF RGBN"))   (P_OLD_FILETYPE)
