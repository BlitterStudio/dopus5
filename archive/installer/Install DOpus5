   (help "")
   (dest "ENV:DOpus5Startup")
   (append #modename))

(set #assignname "no")
(if #assign (set #assignname "yes"))
(textfile
   (prompt "Remember the assign choice in ENVARC:DOpus5Assign")
   (help "")
   (dest "ENVARC:DOpus5Assign")
   (append #assignname))
(textfile
   (prompt "Remember the assign choice in ENV:DOpus5Assign")
   (help "")
   (dest "ENV:DOpus5Assign")
   (append #assignname))

(set #preloadname "no")
(if #preload (set #preloadname "yes"))
(textfile
   (prompt "Remember the boot loading choice in ENVARC:DOpus5Preload")
   (help "")
   (dest "ENVARC:DOpus5Preload")
