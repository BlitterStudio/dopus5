(if #upgrade
    (
       (P_OLD_FILETYPES)
       (if (> #oldft-found 0)
           (if (askbool
                  (prompt "Remove " #oldft-found " outdated files from " #olds "?")
                  (help "Older releases stored the filetypes under other names, for example Picture,_GIF, which is now Graphics, Pic-GIF, and kept copies of filetypes that are installed. This release installed the new files, so the old ones are duplicates.\n\nOnly files whose replacement is present are removed.")
                  (default 1))
               (
                  (set #oldft-pass 1)
                  (P_OLD_FILETYPES)
               )))
    ))

(complete 85)


; --------------------------------------------------------------------
; How Directory Opus starts
; --------------------------------------------------------------------
;
; #mode 0 = manually, 1 = when Workbench starts (Opus5_Startup icon in
; SYS:WBStartup), 2 = instead of Workbench.  The choice is kept in
; ENVARC:DOpus5Startup so that the next run offers it again.
;
; Workbench replacement makes LoadDB resident under the name LoadWB in the
; DOpus5 block of S:User-Startup, which the standard Startup-Sequence runs
; just before its LoadWB line; the Startup-Sequence itself is not changed.
; LoadDB starts Directory Opus with ENVIRONMENT=workbench and
; WBSTARTUP=YES, runs C:LoadWB if Opus cannot start, and runs C:LoadWB
; when Shift is held during boot.  Its own call to c:LoadWB names the
; path, so it loads the real LoadWB, not the resident LoadDB.
; Opus runs SYS:WBStartup itself in this mode, so the Opus5_Startup icon
; must go, or Opus would be started twice.
; AROS starts Wanderer directly, and the stock OS4 and MorphOS
; Startup-Sequences have not been checked, so the option is offered for
; the AmigaOS 3 builds only.

(set #wbs "SYS:WBStartup/Opus5_Startup")
(set #can-replace (= (substr #build 0 3) "os3"))
(set #oldmode (getenv "DOpus5Startup"))

(set #mode 0)
(if (or (= #oldmode "wbstartup") (= 1 (exists #wbs (noreq))))
    (set #mode 1))
(if (and #can-replace (= #oldmode "workbench"))
    (set #mode 2))

(set #mode-help "Manually: start Directory Opus by double-clicking DirectoryOpus in its drawer.\n\nWhen Workbench starts: the Opus5_Startup icon in SYS:WBStartup starts Directory Opus after Workbench. Its tool types set the startup options, for example which environment to load.")

(if #can-replace
    (set #mode
       (askchoice
          (prompt "How should Directory Opus 5 start?")
          (help #mode-help
                "\n\nInstead of Workbench: Directory Opus replaces Workbench and runs the programs in SYS:WBStartup itself. "
                "The DOpus5 block in S:User-Startup makes DOpus5:C/LoadDB resident as LoadWB, so the LoadWB line of the Startup-Sequence starts Directory Opus; the Startup-Sequence is not changed. "
                "Hold Shift while the Amiga boots to start Workbench instead; if Directory Opus cannot start, Workbench starts. "
                "In this mode Directory Opus loads the workbench environment, not the default one."
                "\n\nRunning this installer again lets you change the choice.")
          (choices "Manually" "When Workbench starts" "Instead of Workbench")
          (default #mode)))
    (set #mode
       (askchoice
          (prompt "How should Directory Opus 5 start?")
          (help #mode-help "\n\nRunning this installer again lets you change the choice.")
          (choices "Manually" "When Workbench starts")
          (default #mode))))

(set #modename "manual")
(if (= #mode 1) (set #modename "wbstartup"))
(if (= #mode 2) (set #modename "workbench"))


; --------------------------------------------------------------------
; Loading dopus5.library at boot
; --------------------------------------------------------------------
;
; dopus5.library installs its Workbench patches when it is first opened,
; and Directory Opus only knows about the AppIcons added while they are
; in place.  When Opus is started after Workbench, AppIcons from programs
; in SYS:WBStartup (NewMeter, for example) stay on the Workbench desktop
; behind the Opus desktop.  DOpus5:C/LoadDOpusLib in the DOpus5 block
; opens the library before LoadWB and keeps it open.  Not needed when
; Opus replaces Workbench, because it runs SYS:WBStartup itself.  Offered
; for the AmigaOS 3 builds, where it has been tested.  The choice is kept
; in ENVARC:DOpus5Preload.

(set #oldpreload (getenv "DOpus5Preload"))

(set #preload 0)
(if (and #can-replace (<> #mode 2))
    (set #preload
       (askbool
          (prompt "Load dopus5.library when the Amiga starts?")
          (help "Directory Opus shows the AppIcons that programs add while dopus5.library is loaded. If you start Directory Opus after Workbench, AppIcons added before that, for example by programs in SYS:WBStartup such as NewMeter, stay on the Workbench desktop behind the Opus desktop."
                "\n\nAnswer Yes to add DOpus5:C/LoadDOpusLib to the DOpus5 block in S:User-Startup. It loads dopus5.library before Workbench starts, so Directory Opus shows those AppIcons when you start it. The library and its Workbench patches then stay in memory until the next reboot, also while Directory Opus is not running. The line needs the DOpus5: assign, so the block holds that too."
                "\n\nRunning this installer again lets you change the choice.")
          (default (= #oldpreload "yes")))))

(complete 88)


; --------------------------------------------------------------------
; S:User-Startup: DOpus5: assign, command path, Workbench replacement
; --------------------------------------------------------------------
;
; Directory Opus assigns DOpus5: to its own drawer when it starts, so the
; assign is only needed by things that run without it: ARexx scripts and
; the commands in DOpus5:C started from a Shell, LoadDB, and other
; programs that look for DOpus5:.  Workbench replacement and
; LoadDOpusLib need it.
;
; ENVARC:DOpus5Assign records whether the block holds the assign.  When
; the assign is declined and an earlier run wrote it, the block is
; replaced by a comment so the old lines, which may point at another
; drawer, stop running.  The Installer cannot read S:User-Startup, so
; without the record it would either leave such a block behind or add an
; empty block for users who never had one.

(set #oldassign (getenv "DOpus5Assign"))

(set #assign 1)
(if (and (<> #mode 2) (not #preload))
    (set #assign
       (askbool
          (prompt "Put the DOpus5: assign and the DOpus5:C command path in S:User-Startup?")
          (help "Directory Opus assigns DOpus5: to its own drawer when it starts. The assign in S:User-Startup is needed by ARexx scripts and the commands in DOpus5:C started from a Shell, and by other programs that look for DOpus5: before Directory Opus has started."
                "\n\nThe lines are written in a ;BEGIN DOpus5 / ;END DOpus5 block, which running this installer again replaces. Answering No empties a block written by an earlier run. The change takes effect after the next reboot.")
          (default (<> #oldassign "no")))))

(set #lines (cat "Assign DOpus5: \"" #dest "\"\nPath DOpus5:C ADD"))
(if (= #mode 2)
    (set #lines (cat #lines "\nResident LoadWB DOpus5:C/LoadDB PURE")))
(if #preload
    (set #lines (cat #lines "\nDOpus5:C/LoadDOpusLib")))

; Leaving Workbench replacement or boot loading must take its line out
; again, and declining the assign must take out an assign written earlier.
; Boot loading forces the assign, so an earlier one recorded "yes".
(if (not #assign)
    (set #lines "; Directory Opus 5 needs no commands here"))

(if (or #assign (or (= #oldmode "workbench") (= #oldassign "yes")))
    (startup "DOpus5"
       (prompt "Write these lines to S:User-Startup:\n\n" #lines)
       (help "The lines are written in a ;BEGIN DOpus5 / ;END DOpus5 block, which running this installer again replaces. They take effect after the next reboot.")
       (command #lines)))

(complete 92)


; --------------------------------------------------------------------
