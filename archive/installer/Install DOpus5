   (set #old "IFF_file"                   #new (tackon #olds "System, IFF File"))            (P_OLD_FILETYPE)
   (set #old "Icon"                       #new (tackon #olds "System, Icon"))                (P_OLD_FILETYPE)
   (set #old "Imagine_object,_IFF_TDDD"   #new (tackon #olds "Imagine, Object"))             (P_OLD_FILETYPE)
   (set #old "Imagine_picture,_IFF_RGBN"  #new (tackon #olds "Imagine, Picture"))            (P_OLD_FILETYPE)
   (set #old "LHA_archive"                #new (tackon #olds "Archive, LhA"))                (P_OLD_FILETYPE)
   (set #old "LZX_archive"                #new (tackon #olds "Archive, LZX"))                (P_OLD_FILETYPE)
   (set #old "Maxiplan_worksheet"         #new (tackon #olds "Document, MaxiPlan Worksheet")) (P_OLD_FILETYPE)
   (set #old "Module"                     #new (tackon #olds "Audio, MOD"))                  (P_OLD_FILETYPE)
   (set #old "PNG_files"                  #new (tackon #olds "Graphics, Pic-PNG"))           (P_OLD_FILETYPE)
   (set #old "Pagestream_document"        #new (tackon #olds "Document, PageStream"))        (P_OLD_FILETYPE)
   (set #old "Picture,_GIF"               #new (tackon #olds "Graphics, Pic-GIF"))           (P_OLD_FILETYPE)
   (set #old "Picture,_IFF_ACBM"          #new (tackon #olds "Graphics, Pic-ACBM"))          (P_OLD_FILETYPE)
