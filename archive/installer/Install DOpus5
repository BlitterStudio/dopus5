   (set #old "Picture,_PCX"               #new (tackon #olds "Graphics, Pic-PCX"))           (P_OLD_FILETYPE)
   (set #old "ProWrite_document"          #new (tackon #olds "Document, ProWrite"))          (P_OLD_FILETYPE)
   (set #old "SFX_archive"                #new (tackon #olds "Archive, SFX"))                (P_OLD_FILETYPE)
   (set #old "Shrink_archive"             #new (tackon #olds "Archive, Shrink"))             (P_OLD_FILETYPE)
   (set #old "Sonix_song,_IFF_SMUS"       #new (tackon #olds "Audio, IFF SMUS"))             (P_OLD_FILETYPE)
   (set #old "Sound,_IFF_8SVX"            #new (tackon #olds "Audio, IFF 8SVX"))             (P_OLD_FILETYPE)
   (set #old "Sound_Module"               #new (tackon #olds "Audio, MOD"))                  (P_OLD_FILETYPE)
   (set #old "Text_document,_IFF_FTXT"    #new (tackon #olds "Document, IFF FTXT"))          (P_OLD_FILETYPE)
